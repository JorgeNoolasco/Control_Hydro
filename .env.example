# A integração Supabase/Vercel pode fornecer POSTGRES_URL em vez de DATABASE_URL.
# Use a URI do Transaction pooler (porta 6543) mostrada em Connect no Supabase.
# Nunca use uma chave anon/service_role como senha PostgreSQL.
# URI completa do banco; vazia permite tentar POSTGRES_URL como alternativa.
DATABASE_URL=
# Exige conexão criptografada com PostgreSQL.
DB_SSLMODE=require
# Habilita o armazenamento de sessões no banco também nos testes locais.
SESSION_DRIVER=database
# Gere 32 bytes aleatórios em hexadecimal; não existe valor padrão.
APP_SECRET=
# Origem sem caminho; HTTPS é obrigatório na Vercel.
APP_URL=
APP_ENV=development
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
# Recuperação de senha: remetente verificado, chave com permissão de envio.
RESEND_API_KEY=
MAIL_FROM=
# Alternativa sem URL: DB_DRIVER=pgsql, DB_HOST, DB_PORT=6543,
# DB_NAME=postgres, DB_USER e DB_PASSWORD.
# PHP puro não carrega .env automaticamente. Localmente use CONFIG/local.php.
