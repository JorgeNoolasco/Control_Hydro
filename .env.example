# A integração Supabase/Vercel pode fornecer POSTGRES_URL em vez de DATABASE_URL.
# Use a URI do Transaction pooler (porta 6543) mostrada em Connect no Supabase.
# Nunca use uma chave anon/service_role como senha PostgreSQL.
DATABASE_URL=
DB_SSLMODE=require
SESSION_DRIVER=database
# Alternativa sem URL: DB_DRIVER=pgsql, DB_HOST, DB_PORT=6543,
# DB_NAME=postgres, DB_USER e DB_PASSWORD.
# PHP puro não carrega .env automaticamente. Localmente use CONFIG/local.php.
